  hotelMakkah        String?
  hotelMadinah       String?
  roomType           String?
  occupancyNote      String?
  inclusions         String?
  exclusions         String?
  capacity           Int?
  supplierCostPoisha Int?
  sellingPricePoisha Int?
  notes              String?
  isActive           Boolean     @default(true)
  createdBy          String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime?
