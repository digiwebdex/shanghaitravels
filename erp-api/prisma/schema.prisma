  createdAt       DateTime               @default(now())

  @@unique([requestId, levelNo])
  @@index([requestId])
}

model CorporateSupportRequest {
  id                String          @id @default(uuid())
  corporateClientId String
  corporateClient   CorporateClient @relation(fields: [corporateClientId], references: [id], onDelete: Cascade)
  createdByUserId   String?
  subject           String
  body              String
  status            String          @default("open")
  priority          String          @default("normal")
  applicationId     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  closedAt          DateTime?

  @@index([corporateClientId])
  @@index([status])
}

model CorporateAnnouncement {
  id                String          @id @default(uuid())
  corporateClientId String
  corporateClient   CorporateClient @relation(fields: [corporateClientId], references: [id], onDelete: Cascade)
  title             String
  body              String
  createdByUserId   String?
  createdAt         DateTime        @default(now())
  expiresAt         DateTime?
  deletedAt         DateTime?

  @@index([corporateClientId])
}

// ---------- Phase E3: Package Engine (PackageMaster = single source of truth) ----------
