/// Group operations for Hajj/Umrah departures (Phase B5).
model HajjGroup {
  id            String            @id @default(uuid())
  code          String            @unique
  name          String
  kind          String // hajj | umrah
  packageId     String?
  package       HajjUmrahPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  season        String?
  year          String?
  leaderName    String?
  leaderPhone   String?
  capacity      Int?
  enrolled      Int?
  flightNo      String?
  airline       String?
  transportNote String?
