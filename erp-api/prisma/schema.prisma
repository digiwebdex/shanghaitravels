  leadId        String?
  applicationId String?
  status        String   @default("new")
  createdAt     DateTime @default(now())

  @@index([formType])
  @@index([status])
  @@index([leadId])
  @@index([createdAt])
  @@index([branchId])
}

model CmsPageView {
  id        String   @id @default(uuid())
  pageId    String?
  page      CmsPage? @relation(fields: [pageId], references: [id], onDelete: SetNull)
  path      String
  branchId  String?
  viewedAt  DateTime @default(now())
  referrer  String?
  userAgent String?

  @@index([pageId])
  @@index([path])
  @@index([viewedAt])
}

// ---------- Customer self-service portal (Phase F1) ----------
// SEPARATE from staff + agent auth: JWT_CUSTOMER_SECRET + st_customer cookie
// + aud:"customer". Controllers are @Public() + CustomerJwtGuard. All data
// queries are scoped to the JWT customerId.
model CustomerUser {
  id                 String                 @id @default(uuid())
  customerId         String
  customer           Customer               @relation(fields: [customerId], references: [id])
  email              String                 @unique
  phone              String?
  passwordHash       String
  status             String                 @default("pending") // pending | active | disabled
  emailVerifiedAt    DateTime?
  mustChangePassword Boolean                @default(false)
  lastLoginAt        DateTime?
  createdBy          String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  deletedAt          DateTime?
  sessions           CustomerRefreshToken[]
  authCodes          CustomerAuthCode[]

  @@index([customerId])
  @@index([phone])
}

model CustomerRefreshToken {
  id             String       @id @default(uuid())
  customerUserId String
  customerUser   CustomerUser @relation(fields: [customerUserId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  userAgent      String?
  ip             String?
  createdAt      DateTime     @default(now())

  @@index([customerUserId])
}

/// email_verify | password_reset | login_otp
model CustomerAuthCode {
  id             String        @id @default(uuid())
  customerUserId String?
  customerUser   CustomerUser? @relation(fields: [customerUserId], references: [id], onDelete: Cascade)
  email          String
  purpose        String
  codeHash       String
  expiresAt      DateTime
  consumedAt     DateTime?
  attempts       Int           @default(0)
  createdAt      DateTime      @default(now())

  @@index([email, purpose])
  @@index([customerUserId])
}

model CustomerFamilyMember {
  id           String    @id @default(uuid())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fullName     String
  relationship String?
  dob          DateTime?
  passportNo   String?
  nationality  String?
  phone        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([customerId])
}

model CustomerSavedTraveller {
  id          String    @id @default(uuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fullName    String
  passportNo  String?
  nationality String?
  dob         DateTime?
  phone       String?
  email       String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([customerId])
}

model CustomerEmergencyContact {
  id           String    @id @default(uuid())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fullName     String
  relationship String?
  phone        String
  email        String?
  address      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([customerId])
}

model CustomerSupportRequest {
  id            String    @id @default(uuid())
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subject       String
  body          String
  status        String    @default("open") // open | in_progress | resolved | closed
  priority      String    @default("normal")
  applicationId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  closedAt      DateTime?

  @@index([customerId])
  @@index([status])
}

model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String
  version    Int
  fileName   String
  storageKey String
  mimeType   String
  sizeBytes  Int
  uploadedBy String
  createdAt  DateTime @default(now())

  @@unique([documentId, version])
  @@index([documentId])
}

// ---------- Corporate self-service portal (Phase H1) ----------
// SEPARATE realm: JWT_CORPORATE_SECRET + st_corporate + aud:"corporate".
// Tenant isolation: every query scoped by corporateClientId.
// HR Employee is NOT reused — corporate travellers are CorporateEmployee.

model CorporateUser {
  id                 String                  @id @default(uuid())
  corporateClientId  String
  corporateClient    CorporateClient         @relation(fields: [corporateClientId], references: [id])
  employeeId         String?
  employee           CorporateEmployee?      @relation(fields: [employeeId], references: [id])
  email              String                  @unique
  passwordHash       String
  /// admin | manager | dept_head | finance | travel_desk | employee
  role               String                  @default("admin")
  status             String                  @default("active")
  mustChangePassword Boolean                 @default(true)
  lastLoginAt        DateTime?
  createdBy          String
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  deletedAt          DateTime?
  sessions           CorporateRefreshToken[]
  authCodes          CorporateAuthCode[]

  @@index([corporateClientId])
  @@index([employeeId])
}

model CorporateRefreshToken {
  id              String        @id @default(uuid())
  corporateUserId String
  corporateUser   CorporateUser @relation(fields: [corporateUserId], references: [id], onDelete: Cascade)
  tokenHash       String        @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  userAgent       String?
  ip              String?
  createdAt       DateTime      @default(now())

  @@index([corporateUserId])
}

/// password_reset | login_otp
model CorporateAuthCode {
  id              String         @id @default(uuid())
  corporateUserId String?
  corporateUser   CorporateUser? @relation(fields: [corporateUserId], references: [id], onDelete: Cascade)
  email           String
  purpose         String
  codeHash        String
  expiresAt       DateTime
  consumedAt      DateTime?
  attempts        Int            @default(0)
  createdAt       DateTime       @default(now())

  @@index([email, purpose])
  @@index([corporateUserId])
}

model CorporateEmployee {
  id                  String                       @id @default(uuid())
  corporateClientId   String
  corporateClient     CorporateClient              @relation(fields: [corporateClientId], references: [id], onDelete: Cascade)
  code                String?
  fullName            String
  email               String?
  phone               String?
  department          String?
  designation         String?
  managerEmployeeId   String?
  passportNo          String?
  nationality         String?
  dob                 DateTime?
  isFrequentTraveller Boolean                      @default(false)
  status              String                       @default("active")
  createdBy           String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  deletedAt           DateTime?
  emergencyContacts   CorporateEmployeeEmergency[]
  portalUsers         CorporateUser[]
  travelRequests      CorporateTravelRequest[]

  @@index([corporateClientId])
  @@index([department])
}

model CorporateEmployeeEmergency {
  id           String            @id @default(uuid())
  employeeId   String
  employee     CorporateEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fullName     String
  relationship String?
  phone        String
  email        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  @@index([employeeId])
}

model CorporateApprovalChain {
  id                String                  @id @default(uuid())
  corporateClientId String
  corporateClient   CorporateClient         @relation(fields: [corporateClientId], references: [id], onDelete: Cascade)
  name              String                  @default("Default")
  isDefault         Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  steps             CorporateApprovalStep[]

  @@index([corporateClientId])
}

model CorporateApprovalStep {
  id        String                 @id @default(uuid())
  chainId   String
  chain     CorporateApprovalChain @relation(fields: [chainId], references: [id], onDelete: Cascade)
  levelNo   Int
  /// manager | dept_head | finance | travel_desk
  role      String
  name      String?
  createdAt DateTime               @default(now())

  @@unique([chainId, levelNo])
  @@index([chainId])
}

model CorporateTravelRequest {
  id                String                    @id @default(uuid())
  corporateClientId String
  corporateClient   CorporateClient           @relation(fields: [corporateClientId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          CorporateEmployee         @relation(fields: [employeeId], references: [id])
  requesterUserId   String
  serviceType       String
  title             String?
  message           String?
  destination       String?
