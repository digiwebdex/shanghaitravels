  isActive   Boolean  @default(true)
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive])
}

/// blog | announcement | faq | testimonial | gallery | download
model CmsContent {
  id          String    @id @default(uuid())
  branchId    String?
  type        String
  slug        String
  title       String
  summary     String?
  body        String    @default("")
  coverUrl    String?
  meta        Json?
  /// draft | published | archived
  status      String    @default("draft")
  publishedAt DateTime?
  authorName  String?
  sortOrder   Int       @default(0)
  createdBy   String
  createdAt   DateTime  @default(now())
