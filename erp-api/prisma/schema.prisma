  draft
  published
  archived
  scheduled
}

enum PackageGalleryKind {
  thumbnail
  gallery
  banner
}

enum PackageAvailabilityStatus {
  open
  full
  closed
  cancelled
}

model PackageCategory {
  id          String          @id @default(uuid())
  code        String          @unique
  name        String
  slug        String          @unique
  description String?
  icon        String?
  sortOrder   Int             @default(0)
  isActive    Boolean         @default(true)
  packages    PackageMaster[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  @@index([isActive])
  @@index([sortOrder])
}

model DestinationMaster {
  id               String          @id @default(uuid())
  name             String
  slug             String          @unique
  country          String
  countryCode      String?
  isoCode          String?
  flagEmoji        String?
  flagUrl          String?
  heroImageUrl     String?
  galleryJson      Json?
  region           String?
  visaRequired     Boolean         @default(true)
  popular          Boolean         @default(false)
  featured         Boolean         @default(false)
  homepageFeatured Boolean         @default(false)
  displayOrder     Int             @default(0)
  status           String          @default("draft")
  seoTitle         String?
  seoDescription   String?
  description      String?
  latitude         Float?
  longitude        Float?
  mapEmbedUrl      String?
  createdBy        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?
  packages         PackageMaster[]

  @@index([status])
  @@index([homepageFeatured])
  @@index([popular])
  @@index([region])
  @@index([displayOrder])
  @@index([countryCode])
}

model PackageMaster {
  id                      String                   @id @default(uuid())
  code                    String                   @unique
  name                    String
  slug                    String                   @unique
  categoryId              String
  category                PackageCategory          @relation(fields: [categoryId], references: [id])
  destinationId           String?
  destinationMaster       DestinationMaster?       @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  country                 String?
  destination             String?
  cities                  String?
  durationDays            Int?
  durationNights          Int?
  packageType             String?
  travelStartAt           DateTime?
  travelEndAt             DateTime?
  pricePoisha             Int                      @default(0)
  offerPricePoisha        Int?
  currencyCode            String                   @default("BDT")
  adultPricePoisha        Int?
  childPricePoisha        Int?
  infantPricePoisha       Int?
  singleSupplementPoisha  Int?
  maxPax                  Int?
  minPax                  Int?
  seatsAvailable          Int?
  seatsSold               Int                      @default(0)
  status                  PackageMasterStatus      @default(draft)
  featured                Boolean                  @default(false)
  popular                 Boolean                  @default(false)
  recommended             Boolean                  @default(false)
  homeFeatured            Boolean                  @default(false)
  agentFeatured           Boolean                  @default(false)
  corporateFeatured       Boolean                  @default(false)
  corporateApproved       Boolean                  @default(false)
  tags                    String?
  seoTitle                String?
  seoDescription          String?
  thumbnailUrl            String?
  bannerUrl               String?
  videoUrl                String?
  description             String?
  highlights              String?
  included                String?
  excluded                String?
  terms                   String?
  cancellationPolicy      String?
  visaRequirements        String?
  hotelDetails            String?
  flightDetails           String?
  transportDetails        String?
  mealPlan                String?
  tourPlan                String?
  itineraryJson           Json?
  mapEmbedUrl             String?
  faqJson                 Json?
  ratingAvg               Float?
  ratingCount             Int                      @default(0)
  supplierId              String?
  supplier                Supplier?                @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  agentCommissionBps      Int?
  publishAt               DateTime?
  expireAt                DateTime?
  createdBy               String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  deletedAt               DateTime?
  gallery                 PackageGalleryItem[]
  availability            PackageAvailability[]
  faqs                    PackageFaq[]
  reviews                 PackageReview[]
  wishlists               PackageWishlist[]
  applications            Application[]            @relation("ApplicationPackage")
  leads                   Lead[]                   @relation("LeadPackage")
  opportunities           Opportunity[]            @relation("OpportunityPackage")
  quotations              Quotation[]              @relation("QuotationPackage")
  quotationLines          QuotationLine[]          @relation("QuotationLinePackage")
  invoices                Invoice[]                @relation("InvoicePackage")
  invoiceItems            InvoiceItem[]            @relation("InvoiceItemPackage")
  tourDetails             TourPackageDetail[]      @relation("TourDetailPackage")
  hajjDetails             HajjUmrahDetail[]        @relation("HajjDetailPackage")
  cmsOffers               CmsTravelOffer[]         @relation("CmsOfferPackage")
  corporateTravelRequests CorporateTravelRequest[] @relation("CorporateTravelPackage")

  @@index([categoryId])
  @@index([destinationId])
  @@index([status])
  @@index([destination])
  @@index([country])
  @@index([featured])
  @@index([popular])
  @@index([recommended])
  @@index([homeFeatured])
  @@index([agentFeatured])
  @@index([corporateFeatured])
  @@index([corporateApproved])
  @@index([travelStartAt])
  @@index([deletedAt])
}

model PackageGalleryItem {
  id        String             @id @default(uuid())
  packageId String
  package   PackageMaster      @relation(fields: [packageId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  sortOrder Int                @default(0)
  kind      PackageGalleryKind @default(gallery)
  createdAt DateTime           @default(now())

  @@index([packageId])
}

model PackageAvailability {
  id        String                    @id @default(uuid())
  packageId String
  package   PackageMaster             @relation(fields: [packageId], references: [id], onDelete: Cascade)
  startAt   DateTime
  endAt     DateTime?
  seats     Int?
  seatsSold Int                       @default(0)
  status    PackageAvailabilityStatus @default(open)
  notes     String?
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@index([packageId])
  @@index([startAt])
  @@index([status])
}

model PackageFaq {
  id        String        @id @default(uuid())
  packageId String
  package   PackageMaster @relation(fields: [packageId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([packageId])
}

model PackageReview {
  id          String        @id @default(uuid())
  packageId   String
  package     PackageMaster @relation(fields: [packageId], references: [id], onDelete: Cascade)
  authorName  String
  rating      Int
  body        String?
  isPublished Boolean       @default(true)
  createdAt   DateTime      @default(now())

  @@index([packageId])
}

model PackageWishlist {
  id         String        @id @default(uuid())
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  packageId  String
  package    PackageMaster @relation(fields: [packageId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@unique([customerId, packageId])
  @@index([customerId])
  @@index([packageId])
}
