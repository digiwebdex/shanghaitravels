// ---------- Phase C1 — Finance ERP Foundation (double-entry GL) ----------
// Parallel to cash-basis Account/Invoice/Payment. Never hard-code GL account IDs.

/// Account group (Assets / Liabilities / Equity / Income / Expenses + sub-groups).
model GlAccountGroup {
  id        String           @id @default(uuid())
  code      String           @unique
  name      String
  type      String // asset | liability | equity | income | expense
  parentId  String?
  parent    GlAccountGroup?  @relation("GlGroupTree", fields: [parentId], references: [id])
  children  GlAccountGroup[] @relation("GlGroupTree")
  sortOrder Int              @default(0)
  isActive  Boolean          @default(true)
  accounts  GlAccount[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?
}

/// Configurable Chart of Accounts node (postable or header).
model GlAccount {
  id                 String          @id @default(uuid())
  code               String          @unique
  name               String
  type               String // asset | liability | equity | income | expense
  groupId            String?
  group              GlAccountGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  parentId           String?
  parent             GlAccount?      @relation("GlAccountTree", fields: [parentId], references: [id])
  children           GlAccount[]     @relation("GlAccountTree")
  isHeader           Boolean         @default(false)
  isPostable         Boolean         @default(true)
  currencyCode       String? // null = org base; multi-currency ready
  branchId           String? // null = org-wide; multi-branch ready
  taxCode            String? // future VAT/tax hook
  costCenterRequired Boolean         @default(false)
  description        String?
  sortOrder          Int             @default(0)
  isActive           Boolean         @default(true)
  lines              JournalLine[]
  bankAccounts       BankAccount[]
  createdBy          String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?
}

model FiscalYear {
  id        String             @id @default(uuid())
  code      String             @unique
  name      String
  startDate DateTime
  endDate   DateTime
  status    String             @default("open") // open | closed
  periods   AccountingPeriod[]
  createdBy String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  deletedAt DateTime?
}

model AccountingPeriod {
  id             String                @id @default(uuid())
  fiscalYearId   String
  fiscalYear     FiscalYear            @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  code           String
  name           String
  startDate      DateTime
  endDate        DateTime
  status         String                @default("open") // open | closed | locked
  closedAt       DateTime?
  closedBy       String?
  journals       JournalEntry[]
  reopenRequests PeriodReopenRequest[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?

  @@unique([fiscalYearId, code])
}

model CostCenter {
  id        String        @id @default(uuid())
  code      String        @unique
  name      String
  branchId  String?
  notes     String?
  isActive  Boolean       @default(true)
  lines     JournalLine[]
  createdBy String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
}

model Currency {
  id            String         @id @default(uuid())
  code          String         @unique // BDT, USD, SAR…
  name          String
  symbol        String?
  decimalPlaces Int            @default(2)
  isBase        Boolean        @default(false)
  isActive      Boolean        @default(true)
  ratesFrom     ExchangeRate[] @relation("FxFrom")
  ratesTo       ExchangeRate[] @relation("FxTo")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
}

model ExchangeRate {
  id           String    @id @default(uuid())
  fromCode     String
  fromCurrency Currency  @relation("FxFrom", fields: [fromCode], references: [code])
  toCode       String
  toCurrency   Currency  @relation("FxTo", fields: [toCode], references: [code])
  /// Rate scaled by 1e8 (e.g. 1 USD = 110.50 BDT → 11050000000)
  rateScaled   BigInt
  rateDate     DateTime
  source       String?
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([fromCode, toCode, rateDate])
}

model JournalEntry {
  id                String           @id @default(uuid())
  journalNo         String           @unique
  entryDate         DateTime
  periodId          String
  period            AccountingPeriod @relation(fields: [periodId], references: [id])
  branchId          String?
  /// Journal currency for display; base amounts always in org base (BDT).
  currencyCode      String           @default("BDT")
  type              String           @default("standard") // standard | opening | closing | adjustment
  status            String           @default("draft") // draft | pending_approval | posted | rejected | void
  memo              String?
  reference         String?
  totalDebitPoisha  Int              @default(0)
  totalCreditPoisha Int              @default(0)
  createdBy         String
  submittedBy       String?
  submittedAt       DateTime?
  approvedBy        String?
  approvedAt        DateTime?
  rejectedBy        String?
  rejectedAt        DateTime?
  rejectReason      String?
  postedBy          String?
  postedAt          DateTime?
  voidedBy          String?
  voidedAt          DateTime?
  voidReason        String?
  /// Optional link: this journal reverses another posted journal
  reversesJournalId String?
  reversesJournal   JournalEntry?    @relation("JournalReversal", fields: [reversesJournalId], references: [id], onDelete: SetNull)
  reversedBy        JournalEntry[]   @relation("JournalReversal")
  lines             JournalLine[]
  arDocuments       ArDocument[]
  apDocuments       ApDocument[]
  bankMovements     BankMovement[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  @@index([entryDate])
  @@index([status])
  @@index([periodId])
  @@index([reversesJournalId])
}

model JournalLine {
  id               String       @id @default(uuid())
  journalId        String
  journal          JournalEntry @relation(fields: [journalId], references: [id], onDelete: Cascade)
  lineNo           Int
  glAccountId      String
  glAccount        GlAccount    @relation(fields: [glAccountId], references: [id])
  costCenterId     String?
  costCenter       CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  debitPoisha      Int          @default(0)
  creditPoisha     Int          @default(0)
  currencyCode     String       @default("BDT")
  fxRateScaled     BigInt?
  /// Amounts in org base currency (BDT) used for balancing & TB.
  debitBasePoisha  Int          @default(0)
  creditBasePoisha Int          @default(0)
  memo             String?
  createdAt        DateTime     @default(now())

  @@index([glAccountId])
  @@index([journalId, lineNo])
}

// ---------- Phase C2 — Accounts Receivable / Accounts Payable ----------
// Parallel accrual subledgers. Cash Invoice/Payment remain the operational
// billing path; AR/AP documents post journals through Phase C1 GL engine.

model ArDocument {
  id              String           @id @default(uuid())
  docNo           String           @unique
  /// invoice | receipt | advance | credit_note | debit_note | refund
  type            String
  /// draft | pending_approval | approved | posted | rejected | void
  status          String           @default("draft")
  branchId        String?
  customerId      String
  customer        Customer         @relation(fields: [customerId], references: [id])
  applicationId   String?
  application     Application?     @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  /// Optional link to cash-basis operational invoice
  invoiceId       String?
  invoice         Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  currencyCode    String           @default("BDT")
  issueDate       DateTime
  dueDate         DateTime?
  subtotalPoisha  Int              @default(0)
  taxPoisha       Int              @default(0)
  totalPoisha     Int              @default(0)
  /// Remaining open amount (updated on allocate/post)
  balancePoisha   Int              @default(0)
  memo            String?
  reference       String?
  journalId       String?
  journal         JournalEntry?    @relation(fields: [journalId], references: [id], onDelete: SetNull)
  lines           ArDocumentLine[]
  allocationsFrom ArAllocation[]   @relation("ArAllocFrom")
  allocationsTo   ArAllocation[]   @relation("ArAllocTo")
  createdBy       String
  submittedBy     String?
  submittedAt     DateTime?
  approvedBy      String?
  approvedAt      DateTime?
  rejectedBy      String?
  rejectedAt      DateTime?
  rejectReason    String?
  postedBy        String?
  postedAt        DateTime?
  voidedBy        String?
  voidedAt        DateTime?
  voidReason      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  @@index([customerId])
  @@index([applicationId])
  @@index([status])
  @@index([type])
  @@index([issueDate])
}

model ArDocumentLine {
  id              String     @id @default(uuid())
  documentId      String
  document        ArDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  lineNo          Int
  description     String
  quantity        Int        @default(1)
  unitPricePoisha Int        @default(0)
  amountPoisha    Int        @default(0)
  glAccountCode   String? // optional override (default by doc type)
  createdAt       DateTime   @default(now())

  @@index([documentId])
}

/// Apply receipt/credit/advance against an AR invoice (or reverse).
model ArAllocation {
  id           String     @id @default(uuid())
  fromDocId    String
  fromDoc      ArDocument @relation("ArAllocFrom", fields: [fromDocId], references: [id], onDelete: Cascade)
  toDocId      String
  toDoc        ArDocument @relation("ArAllocTo", fields: [toDocId], references: [id], onDelete: Cascade)
  amountPoisha Int
  createdBy    String
  createdAt    DateTime   @default(now())

  @@index([fromDocId])
  @@index([toDocId])
}

model ApDocument {
  id              String           @id @default(uuid())
  docNo           String           @unique
  /// bill | payment | advance | credit_note | debit_note
  type            String
  /// draft | pending_approval | approved | posted | rejected | void
  status          String           @default("draft")
  branchId        String?
  supplierId      String
  supplier        Supplier         @relation(fields: [supplierId], references: [id])
  applicationId   String?
  application     Application?     @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  currencyCode    String           @default("BDT")
  issueDate       DateTime
  dueDate         DateTime?
  subtotalPoisha  Int              @default(0)
  taxPoisha       Int              @default(0)
  totalPoisha     Int              @default(0)
  balancePoisha   Int              @default(0)
  memo            String?
  reference       String?
  journalId       String?
  journal         JournalEntry?    @relation(fields: [journalId], references: [id], onDelete: SetNull)
  lines           ApDocumentLine[]
  allocationsFrom ApAllocation[]   @relation("ApAllocFrom")
  allocationsTo   ApAllocation[]   @relation("ApAllocTo")
  createdBy       String
  submittedBy     String?
  submittedAt     DateTime?
  approvedBy      String?
  approvedAt      DateTime?
  rejectedBy      String?
  rejectedAt      DateTime?
  rejectReason    String?
  postedBy        String?
  postedAt        DateTime?
  voidedBy        String?
  voidedAt        DateTime?
  voidReason      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  @@index([supplierId])
  @@index([applicationId])
  @@index([status])
  @@index([type])
  @@index([issueDate])
}

model ApDocumentLine {
  id              String     @id @default(uuid())
  documentId      String
  document        ApDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  lineNo          Int
  description     String
  quantity        Int        @default(1)
  unitPricePoisha Int        @default(0)
  amountPoisha    Int        @default(0)
  glAccountCode   String?
  createdAt       DateTime   @default(now())

  @@index([documentId])
}

model ApAllocation {
  id           String     @id @default(uuid())
  fromDocId    String
  fromDoc      ApDocument @relation("ApAllocFrom", fields: [fromDocId], references: [id], onDelete: Cascade)
  toDocId      String
  toDoc        ApDocument @relation("ApAllocTo", fields: [toDocId], references: [id], onDelete: Cascade)
  amountPoisha Int
  createdBy    String
  createdAt    DateTime   @default(now())

  @@index([fromDocId])
  @@index([toDocId])
}

// ---------- Phase C3 — Banking & Cash Management ----------
model BankMaster {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  swiftBic    String?
  countryCode String?       @default("BD")
  notes       String?
  isActive    Boolean       @default(true)
  accounts    BankAccount[]
  createdBy   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
}

model BankAccount {
  id                   String          @id @default(uuid())
  branchId             String?
  bankMasterId         String?
  bankMaster           BankMaster?     @relation(fields: [bankMasterId], references: [id], onDelete: SetNull)
  kind                 String          @default("bank")
  name                 String
  accountNo            String?
  iban                 String?
  currencyCode         String          @default("BDT")
  glAccountId          String
  glAccount            GlAccount       @relation(fields: [glAccountId], references: [id])
  cashAccountId        String?
  cashAccount          Account?        @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)
  openingBalancePoisha Int             @default(0)
  isActive             Boolean         @default(true)
  notes                String?
  movementsFrom        BankMovement[]  @relation("MovFrom")
  movementsTo          BankMovement[]  @relation("MovTo")
  cheques              Cheque[]
  statements           BankStatement[]
  createdBy            String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  deletedAt            DateTime?

  @@index([kind])
  @@index([glAccountId])
  @@index([branchId])
}

model BankMovement {
  id                String        @id @default(uuid())
  movementNo        String        @unique
  type              String
  status            String        @default("draft")
  branchId          String?
  fromBankAccountId String?
  fromBankAccount   BankAccount?  @relation("MovFrom", fields: [fromBankAccountId], references: [id], onDelete: SetNull)
  toBankAccountId   String?
  toBankAccount     BankAccount?  @relation("MovTo", fields: [toBankAccountId], references: [id], onDelete: SetNull)
  amountPoisha      Int
  movementDate      DateTime
  memo              String?
  reference         String?
  journalId         String?
  journal           JournalEntry? @relation(fields: [journalId], references: [id], onDelete: SetNull)
  chequeId          String?
  arDocumentId      String?
  apDocumentId      String?
  paymentId         String?
  applicationId     String?
  createdBy         String
  postedBy          String?
  postedAt          DateTime?
  voidedBy          String?
  voidedAt          DateTime?
  voidReason        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  @@index([type])
  @@index([status])
  @@index([movementDate])
  @@index([fromBankAccountId])
  @@index([toBankAccountId])
}

model Cheque {
  id            String      @id @default(uuid())
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])
  direction     String
  chequeNo      String
  chequeDate    DateTime
  amountPoisha  Int
  payeeOrDrawer String?
  status        String      @default("received")
  printedAt     DateTime?
  printPayload  Json?
  clearedAt     DateTime?
  bounceReason  String?
  movementId    String?
  arDocumentId  String?
  apDocumentId  String?
  memo          String?
  createdBy     String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  @@unique([bankAccountId, chequeNo])
  @@index([status])
  @@index([chequeDate])
}

model BankStatement {
  id                   String               @id @default(uuid())
  bankAccountId        String
  bankAccount          BankAccount          @relation(fields: [bankAccountId], references: [id])
  statementDate        DateTime
  periodStart          DateTime?
  periodEnd            DateTime?
  openingBalancePoisha Int                  @default(0)
  closingBalancePoisha Int                  @default(0)
  source               String               @default("manual")
  importRef            String?
  status               String               @default("open")
  lines                BankStatementLine[]
  reconciliations      BankReconciliation[]
  createdBy            String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?

  @@index([bankAccountId])
  @@index([statementDate])
}

model BankStatementLine {
  id                String        @id @default(uuid())
  statementId       String
  statement         BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  lineNo            Int
  txnDate           DateTime
  description       String
  amountPoisha      Int
  bankRef           String?
  matchStatus       String        @default("unmatched")
  matchedMovementId String?
  matchedJournalId  String?
  createdAt         DateTime      @default(now())

  @@index([statementId])
  @@index([matchStatus])
}

model BankReconciliation {
  id                     String         @id @default(uuid())
  bankAccountId          String
  statementId            String?
  statement              BankStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)
  asOfDate               DateTime
  statementBalancePoisha Int            @default(0)
  bookBalancePoisha      Int            @default(0)
  differencePoisha       Int            @default(0)
  status                 String         @default("in_progress")
  notes                  String?
  completedAt            DateTime?
  completedBy            String?
  createdBy              String
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  deletedAt              DateTime?

  @@index([bankAccountId])
  @@index([status])
}

model ChequePrintConfig {
  id        String   @id @default(uuid())
  name      String   @unique @default("default")
  template  Json
  isActive  Boolean  @default(true)
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ---------- Phase C4 — Financial Statements / Closing controls ----------
model PeriodReopenRequest {
  id          String           @id @default(uuid())
  periodId    String
  period      AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  reason      String
  /// pending | approved | rejected
  status      String           @default("pending")
  requestedBy String
  requestedAt DateTime         @default(now())
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([periodId])
  @@index([status])
}

model ClosingRun {
  id               String    @id @default(uuid())
  /// period | year_end | roll_forward
  type             String
  fiscalYearId     String?
  periodId         String?
  closingJournalId String?
  openingJournalId String?
  /// draft | completed | failed
  status           String    @default("completed")
  notes            String?
  meta             Json?
  createdBy        String
  completedAt      DateTime?
  createdAt        DateTime  @default(now())

  @@index([type])
  @@index([fiscalYearId])
}

/// Phase D4 — saved analytics report templates
model AnalyticsReportTemplate {
  id          String                     @id @default(uuid())
  branchId    String?
  code        String                     @unique
  name        String
  /// executive | customer | sales | comms | finance
  category    String
  description String?
  /// JSON: { metrics: string[], defaultFilters?: object }
  definition  Json
  isSystem    Boolean                    @default(false)
  isActive    Boolean                    @default(true)
  createdBy   String
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  deletedAt   DateTime?
  schedules   AnalyticsScheduledReport[]

  @@index([category])
  @@index([branchId])
}

/// Phase D4 — scheduled report definitions (execution engine deferred)
model AnalyticsScheduledReport {
  id         String                  @id @default(uuid())
  branchId   String?
  templateId String
  template   AnalyticsReportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  /// cron-like expression e.g. "0 8 * * 1" (stored; not executed in D4)
  cronExpr   String
  /// csv | excel | html | pdf
  format     String                  @default("csv")
  filters    Json?
  /// JSON array of email recipients
  recipients Json?
  isActive   Boolean                 @default(true)
  nextRunAt  DateTime?
  lastRunAt  DateTime?
  createdBy  String
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  deletedAt  DateTime?

  @@index([templateId])
  @@index([isActive])
  @@index([branchId])
}

/// Phase E — page version history
model CmsPageVersion {
