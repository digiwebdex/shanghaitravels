/// Pilgrim profile catalog (Phase B5).
model HajjPilgrim {
  id               String    @id @default(uuid())
  code             String    @unique
  fullName         String
  passportNo       String?
  nationality      String?
  gender           String? // M | F
  dob              String?
  phone            String?
  email            String?
  mahramName       String?
  mahramRelation   String?
  healthNotes      String?
  emergencyContact String?
  emergencyPhone   String?
  visaStatus       String? // not_applied | applied | approved | rejected
