# Copy to .env (chmod 600). NEVER commit real values.
DATABASE_URL="postgresql://st_erp:CHANGE_ME@127.0.0.1:5432/st_erp_staging?schema=public"
PORT=4201
NODE_ENV=staging

# Auth
JWT_ACCESS_SECRET="CHANGE_ME_64_hex"
JWT_REFRESH_SECRET="CHANGE_ME_64_hex_different"
ACCESS_TTL="15m"
REFRESH_TTL_DAYS=30
COOKIE_SECURE=true        # served over HTTPS via Cloudflare/nginx

# Local file storage (StorageService local driver; R2/S3 later)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR="/var/data/st-erp/uploads"

# ---- Communication delivery (Wave 1) ----
# Leave the provider vars UNSET to keep simulation. COMMS_SIMULATE_DELIVERY=1 makes
# the null adapters mark messages "sent" (simulated) for staging/demo. Set a real
# provider per channel to switch to production delivery — code needs no change.
COMMS_SIMULATE_DELIVERY=1
# Email via nodemailer SMTP:
# COMMS_EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false            # true for port 465
# SMTP_USER=apikey_or_user
# SMTP_PASS=CHANGE_ME
# SMTP_FROM="Shanghai Travels <no-reply@example.com>"
# WhatsApp via Wasender HTTP API:
# COMMS_WHATSAPP_PROVIDER=wasender
# COMMS_WASENDER_API_KEY=CHANGE_ME
# COMMS_WASENDER_API_URL=https://wasenderapi.com/api/send-message
# SMS via a generic JSON HTTP gateway:
# COMMS_SMS_PROVIDER=http
# COMMS_SMS_API_URL=https://sms-gateway.example.com/send
# COMMS_SMS_API_KEY=CHANGE_ME
# COMMS_SMS_SENDER=ShanghaiTvl
